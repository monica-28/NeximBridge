{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "NeximLogging": {
    "FilePath": "logs/neximbridge-.log",
    "RetainedFileCountLimit": 30,
    "FileSizeLimitBytes": 20971520
  },
  "Nexim": {
    "Host": "127.0.0.1",
    "Port": 30040,
    "MachineName": "",
    "InitializationTimeoutSeconds": 10,
    "Events": [
      {
        "Name": "PARTSUSAGE",
        "Ack": true
      },
      {
        "Name": "PDERROR",
        "Ack": true
      },
      {
        "Name": "PRODSTARTED",
        "Ack": true
      },
      {
        "Name": "PRODCOMPLETEDII",
        "Ack": true
      },
      {
        "Name": "PRODSTOPPED",
        "Ack": true
      },
      {
        "Name": "LOADCOMPIV",
        "Ack": false
      },
      {
        "Name": "CHANGECOMPII",
        "Ack": false
      },
      {
        "Name": "UNLOADCOMP",
        "Ack": false
      },
      {
        "Name": "MCALARMON",
        "Ack": true
      },
      {
        "Name": "MCALARMOFF",
        "Ack": true
      }
    ],
    "SQL": {
      "ConnectionString": "Server=.\\SQLEXPRESS;Database=NeximBridge;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;"
    }
  }
}
